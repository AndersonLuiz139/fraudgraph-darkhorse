# Copie este arquivo para ".env" e preencha.

# ---------------- Neo4j ----------------
# Neo4j Desktop ou Docker:  bolt://localhost:7687
# Neo4j Aura (nuvem):       neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=senha12345

# ---------------- LLM (opcional) ----------------
# Sem LLM o sistema funciona com respostas por template.
# Qualquer provedor compatível com a API da OpenAI funciona. Escolha UM bloco:

# --- Google Gemini (tem plano gratuito; chave em https://aistudio.google.com/apikey) ---
# Confira no AI Studio o nome do modelo "Flash" mais recente e coloque em LLM_MODEL.
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=sua_chave_aqui
# LLM_MODEL=gemini-2.5-flash

# --- OpenAI ---
# LLM_BASE_URL=
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Ollama (local, sem internet; rode antes: ollama pull llama3.1) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# ---------------- Embeddings (opcional) ----------------
# Vazio = LSA local (TF-IDF + SVD). Se preencher, rode de novo: python embeddings.py && python carregar_neo4j.py
# Gemini: gemini-embedding-001 | OpenAI: text-embedding-3-small | Ollama: nomic-embed-text
EMBED_MODEL=
